# Пример настроек production. Копия deploy/.env в репозиторий не попадает (.gitignore). Секреты храните в менеджере секретов.
POSTGRES_PASSWORD=замените-случайным-паролем
TIPS_ENV=production
TIPS_API_V1=off
TIPS_FRONT_URL=https://tips.example.ru/p
TIPS_CORS_ORIGINS=
TIPS_TRUSTED_PROXY_HOPS=1
# случайный ключ не короче 16 символов (v1 подписывает им QR, но при TIPS_API_V1=off он нужен только для запуска)
TIPS_HMAC_SECRET=замените
# python -m tips.http.keys qr   и   python -m tips.http.keys
TIPS_QR_ACTIVE_KID=
TIPS_QR_KEYS=
TIPS_JWT_KID=
TIPS_JWT_PRIVATE_KEY=
# мониторинг: Authorization: Bearer <токен>, не короче 24 символов; пусто = /metrics выключен
TIPS_METRICS_TOKEN=
# провайдер: пусто, пока не подключён реальный (платёжный экран при этом заблокирован)
TIPS_PROVIDER=
