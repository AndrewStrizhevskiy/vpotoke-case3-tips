<mxfile host="app.diagrams.net"><diagram id="system" name="Схема системы"><mxGraphModel dx="1660" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1660" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="client" value="&lt;b&gt;Клиент&lt;/b&gt;&lt;br&gt;телефон, браузер&lt;br&gt;сканирует QR,&lt;br&gt;выбирает чаевые" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#868e96;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#343a40;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="240" height="130" as="geometry"/></mxCell><mxCell id="waiter" value="&lt;b&gt;Официант / мерчант&lt;/b&gt;&lt;br&gt;кабинет: QR на чек,&lt;br&gt;свои чаевые, отчёты" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#868e96;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#343a40;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="240" height="130" as="geometry"/></mxCell><mxCell id="pos" value="&lt;b&gt;Касса (POS)&lt;/b&gt;&lt;br&gt;реестр чеков:&lt;br&gt;receipt_id, сумма" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#868e96;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#343a40;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="240" height="130" as="geometry"/></mxCell><mxCell id="admin" value="&lt;b&gt;Администратор&lt;/b&gt;&lt;br&gt;активация и блокировка&lt;br&gt;мерчантов, справочники" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#868e96;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#343a40;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="240" height="130" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;API платформы&lt;/b&gt;&lt;br&gt;HTTPS (TLS)&lt;br&gt;аутентификация (JWT)&lt;br&gt;RBAC: 4 роли&lt;br&gt;rate limit → 429&lt;br&gt;формат запроса → 400&lt;br&gt;маскирование логов&lt;br&gt;&amp;nbsp;&lt;br&gt;/api/v1/qr&lt;br&gt;/api/v1/tips&lt;br&gt;/api/v1/payments/{id}/&lt;br&gt;    confirm · cancel&lt;br&gt;/api/v1/reports/tips" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#e7f0fb;strokeColor=#3b6fb6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#343a40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="440" y="110" width="240" height="700" as="geometry"/></mxCell><mxCell id="svc" value="&lt;b&gt;Сервис чаевых — бизнес-логика&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f2f8f2;strokeColor=#3d8b4f;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#343a40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="780" y="110" width="460" height="470" as="geometry"/></mxCell><mxCell id="qr" value="&lt;b&gt;QR-модуль&lt;/b&gt;&lt;br&gt;генерация: nonce, exp ≤ 24 ч, HMAC-SHA256&lt;br&gt;проверка: подпись → exp → nonce → мерчант → чек" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d8b4f;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#343a40;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="800" y="160" width="420" height="110" as="geometry"/></mxCell><mxCell id="pay" value="&lt;b&gt;Платёжный модуль&lt;/b&gt;&lt;br&gt;сумма из реестра чеков, расчёт в Decimal&lt;br&gt;лимиты P-1, Q-6, P-3&lt;br&gt;идемпотентность P-2, блокировка QR&lt;br&gt;CREATED → PENDING → SUCCESS / DECLINED" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d8b4f;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#343a40;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="800" y="290" width="420" height="140" as="geometry"/></mxCell><mxCell id="rep" value="&lt;b&gt;Отчёты&lt;/b&gt;&lt;br&gt;мерчант · официант · день&lt;br&gt;чаевые: только SUCCESS" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d8b4f;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#343a40;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="800" y="450" width="200" height="110" as="geometry"/></mxCell><mxCell id="rec" value="&lt;b&gt;Сверка (job)&lt;/b&gt;&lt;br&gt;PENDING &amp;gt; 15 мин →&lt;br&gt;DECLINED,&lt;br&gt;GATEWAY_TIMEOUT" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d8b4f;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#343a40;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1020" y="450" width="200" height="110" as="geometry"/></mxCell><mxCell id="sec" value="&lt;b&gt;Секреты&lt;/b&gt;&lt;br&gt;env: TIPS_HMAC_SECRET,&lt;br&gt;пароль БД;&lt;br&gt;не в Git и не в логах" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fff9db;strokeColor=#b0901a;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#343a40;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1360" y="160" width="260" height="110" as="geometry"/></mxCell><mxCell id="emu" value="&lt;b&gt;Эмулятор шлюза&lt;/b&gt;&lt;br&gt;1) gateway_scenarios.csv&lt;br&gt;2) h = md5(qr_id + nonce) mod 10&lt;br&gt;0–7 SUCCESS · 8 DECLINED&lt;br&gt;9 TIMEOUT" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fff3e3;strokeColor=#d9822b;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#343a40;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1360" y="290" width="260" height="140" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;Хранилище&lt;/b&gt;&lt;br&gt;merchants, employees (реквизиты ****NNNN)&lt;br&gt;receipts, qr_links&lt;br&gt;payments (+ payments_out.csv), idempotency_keys&lt;br&gt;reports — пересчитываемый агрегат" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f3effa;strokeColor=#7048a8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#343a40;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="780" y="660" width="460" height="170" as="geometry"/></mxCell><mxCell id="aud" value="&lt;b&gt;Аудит&lt;/b&gt;&lt;br&gt;audit_events, только дописывание&lt;br&gt;событие на каждый переход:&lt;br&gt;event_id, payment_id, qr_id,&lt;br&gt;action, from → to, amount_total,&lt;br&gt;actor, at" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fdeeee;strokeColor=#c0392b;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#343a40;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1360" y="660" width="260" height="170" as="geometry"/></mxCell><mxCell id="e0" value="③ GET /qr/{id}?sig=&lt;br&gt;④ POST /tips&lt;br&gt;⑤ confirm · cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.385;exitDx=0;exitDy=0;entryX=0.000;entryY=0.071;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="api"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-36" as="offset"/></mxGeometry></mxCell><mxCell id="e1" value="QRResponse · Payment&lt;br&gt;Error {code, retryable}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.000;exitY=0.136;exitDx=0;exitDy=0;entryX=1.000;entryY=0.731;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="client"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="23" as="offset"/></mxGeometry></mxCell><mxCell id="e2" value="① POST /qr&lt;br&gt;{receipt_id}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.385;exitDx=0;exitDy=0;entryX=0.000;entryY=0.343;entryDx=0;entryDy=0;" edge="1" parent="1" source="waiter" target="api"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-28" as="offset"/></mxGeometry></mxCell><mxCell id="e3" value="② ссылка ?qr=&amp;amp;sig=&lt;br&gt;+ картинка QR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.000;exitY=0.400;exitDx=0;exitDy=0;entryX=1.000;entryY=0.692;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="waiter"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="23" as="offset"/></mxGeometry></mxCell><mxCell id="e4" value="чек {receipt_id,&lt;br&gt;amount}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.636;entryDx=0;entryDy=0;" edge="1" parent="1" source="pos" target="api"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-28" as="offset"/></mxGeometry></mxCell><mxCell id="e5" value="статус мерчанта,&lt;br&gt;справочники" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.907;entryDx=0;entryDy=0;" edge="1" parent="1" source="admin" target="api"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-28" as="offset"/></mxGeometry></mxCell><mxCell id="e6" value="запрос&lt;br&gt;+ роль" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.336;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="svc"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-28" as="offset"/></mxGeometry></mxCell><mxCell id="e7" value="ответ&lt;br&gt;или ошибка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.000;exitY=0.585;exitDx=0;exitDy=0;entryX=1.000;entryY=0.393;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc" target="api"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="23" as="offset"/></mxGeometry></mxCell><mxCell id="e8" value="HMAC-ключ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="sec" target="qr"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-20" as="offset"/></mxGeometry></mxCell><mxCell id="e9" value="⑥ payment_id,&lt;br&gt;qr_id, nonce" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.321;exitDx=0;exitDy=0;entryX=0.000;entryY=0.321;entryDx=0;entryDy=0;" edge="1" parent="1" source="pay" target="emu"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-28" as="offset"/></mxGeometry></mxCell><mxCell id="e10" value="⑦ SUCCESS /&lt;br&gt;DECLINED /&lt;br&gt;TIMEOUT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.000;exitY=0.750;exitDx=0;exitDy=0;entryX=1.000;entryY=0.750;entryDx=0;entryDy=0;" edge="1" parent="1" source="emu" target="pay"><mxGeometry relative="1" as="geometry"><mxPoint x="10" y="31" as="offset"/></mxGeometry></mxCell><mxCell id="e11" value="запрос статуса" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.455;exitDx=0;exitDy=0;entryX=0.500;entryY=1.000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="rec" target="emu"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-13" as="offset"/><Array as="points"><mxPoint x="1490" y="500"/></Array></mxGeometry></mxCell><mxCell id="e12" value="чтение / запись" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc" target="db"><mxGeometry relative="1" as="geometry"><mxPoint x="10" y="1" as="offset"/></mxGeometry></mxCell><mxCell id="e13" value="⑧ событие перехода" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.926;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc" target="aud"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="17" as="offset"/><Array as="points"><mxPoint x="1490" y="545"/></Array></mxGeometry></mxCell><mxCell id="title" value="&lt;b&gt;Онлайн-чаевые — схема системы&lt;/b&gt;" style="text;html=1;fontSize=24;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="700" height="40" as="geometry"/></mxCell><mxCell id="flow" value="Основной поток: ① официант запрашивает QR на чек → ② получает ссылку с подписью → ③ клиент открывает её и видит сумму из реестра →&lt;br&gt;④ создаёт платёж (CREATED) → ⑤ подтверждает (PENDING) → ⑥ запрос в шлюз → ⑦ исход SUCCESS / DECLINED / TIMEOUT → ⑧ событие в аудит.&lt;br&gt;Прототип: CLI заменяет клиента и API, CSV-файлы — хранилище, emulate_gateway() — шлюз. Оранжевым отмечена эмулируемая внешняя система." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#ced4da;align=left;spacingLeft=14;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1580" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>