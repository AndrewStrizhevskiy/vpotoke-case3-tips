<mxfile host="app.diagrams.net"><diagram id="states" name="Состояния платежа"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1320" pageHeight="1030"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="" style="ellipse;fillColor=#212529;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="315" width="20" height="20" as="geometry"/></mxCell><mxCell id="CREATED" value="&lt;b&gt;CREATED&lt;/b&gt;&lt;br&gt;суммы зафиксированы&lt;br&gt;QR заблокирован" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0fb;strokeColor=#3b6fb6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="140" y="280" width="200" height="90" as="geometry"/></mxCell><mxCell id="PENDING" value="&lt;b&gt;PENDING&lt;/b&gt;&lt;br&gt;запрос в шлюзе&lt;br&gt;QR заблокирован" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0fb;strokeColor=#3b6fb6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="280" width="200" height="90" as="geometry"/></mxCell><mxCell id="SUCCESS" value="&lt;b&gt;SUCCESS&lt;/b&gt;&lt;br&gt;деньги списаны&lt;br&gt;nonce погашен → QR_USED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#2f7d43;strokeWidth=2;fontSize=13;shape=doubleRect;" vertex="1" parent="1"><mxGeometry x="960" y="110" width="220" height="90" as="geometry"/></mxCell><mxCell id="DECLINED" value="&lt;b&gt;DECLINED&lt;/b&gt;&lt;br&gt;списания нет&lt;br&gt;QR свободен до exp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeeee;strokeColor=#c0392b;strokeWidth=2;fontSize=13;shape=doubleRect;" vertex="1" parent="1"><mxGeometry x="960" y="420" width="220" height="90" as="geometry"/></mxCell><mxCell id="CANCELED" value="&lt;b&gt;CANCELED&lt;/b&gt;&lt;br&gt;до отправки в шлюз&lt;br&gt;QR свободен до exp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#6c757d;strokeWidth=2;fontSize=13;shape=doubleRect;" vertex="1" parent="1"><mxGeometry x="520" y="580" width="200" height="90" as="geometry"/></mxCell><mxCell id="e0" value="④ POST /tips" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="CREATED"><mxGeometry relative="1" as="geometry"><mxPoint x="-43" y="23" as="offset"/></mxGeometry></mxCell><mxCell id="e1" value="⑤ confirm&lt;br&gt;(client)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="CREATED" target="PENDING"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-28" as="offset"/></mxGeometry></mxCell><mxCell id="e2" value="h = 0–7&lt;br&gt;(system)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.222;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="PENDING" target="SUCCESS"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="-100" as="offset"/><Array as="points"><mxPoint x="840" y="300"/><mxPoint x="840" y="155"/></Array></mxGeometry></mxCell><mxCell id="e3" value="h = 8&lt;br&gt;CARD_DECLINED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.778;exitDx=0;exitDy=0;entryX=0.000;entryY=0.278;entryDx=0;entryDy=0;" edge="1" parent="1" source="PENDING" target="DECLINED"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="20" as="offset"/><Array as="points"><mxPoint x="840" y="350"/><mxPoint x="840" y="445"/></Array></mxGeometry></mxCell><mxCell id="e4" value="сверка: 15 мин без ответа,&lt;br&gt;GATEWAY_TIMEOUT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.800;exitY=1.000;exitDx=0;exitDy=0;entryX=0.000;entryY=0.778;entryDx=0;entryDy=0;" edge="1" parent="1" source="PENDING" target="DECLINED"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="86" as="offset"/><Array as="points"><mxPoint x="680" y="490"/></Array></mxGeometry></mxCell><mxCell id="e5" value="h = 9: TIMEOUT, ответ 202,&lt;br&gt;ждём сверку" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.300;exitY=0.000;exitDx=0;exitDy=0;entryX=0.700;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="PENDING" target="PENDING"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-30" as="offset"/><Array as="points"><mxPoint x="580" y="220"/><mxPoint x="660" y="220"/></Array></mxGeometry></mxCell><mxCell id="e6" value="cancel (client) или&lt;br&gt;exp / 15 мин без confirm (system)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="CREATED" target="CANCELED"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="96" as="offset"/><Array as="points"><mxPoint x="240" y="625"/></Array></mxGeometry></mxCell><mxCell id="e7" value="409&lt;br&gt;CANCEL_NOT_ALLOWED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#c0392b;fontColor=#c0392b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="PENDING" target="CANCELED"><mxGeometry relative="1" as="geometry"><mxPoint x="-14" y="64" as="offset"/></mxGeometry></mxCell><mxCell id="e8" value="409 CANCEL_NOT_ALLOWED: возвратов в проекте нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#c0392b;fontColor=#c0392b;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.778;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="SUCCESS" target="CANCELED"><mxGeometry relative="1" as="geometry"><mxPoint x="-270" y="220" as="offset"/><Array as="points"><mxPoint x="1260" y="155"/><mxPoint x="1260" y="650"/></Array></mxGeometry></mxCell><mxCell id="table" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;font-size:12px&quot;&gt;&lt;tr&gt;&lt;th&gt;Переход&lt;/th&gt;&lt;th&gt;Триггер&lt;/th&gt;&lt;th&gt;actor&lt;/th&gt;&lt;th&gt;Событие аудита&lt;/th&gt;&lt;th&gt;Ответ&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;— → CREATED&lt;/td&gt;&lt;td&gt;POST /tips, проверки Q и P пройдены&lt;/td&gt;&lt;td&gt;client&lt;/td&gt;&lt;td&gt;payment_created&lt;/td&gt;&lt;td&gt;201 (повтор ключа: 200)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CREATED → PENDING&lt;/td&gt;&lt;td&gt;POST /payments/{id}/confirm&lt;/td&gt;&lt;td&gt;client&lt;/td&gt;&lt;td&gt;payment_submitted&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;PENDING → SUCCESS&lt;/td&gt;&lt;td&gt;эмулятор: h = 0–7&lt;/td&gt;&lt;td&gt;system&lt;/td&gt;&lt;td&gt;payment_confirmed&lt;/td&gt;&lt;td&gt;200&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;PENDING → DECLINED&lt;/td&gt;&lt;td&gt;эмулятор: h = 8&lt;/td&gt;&lt;td&gt;system&lt;/td&gt;&lt;td&gt;payment_declined&lt;/td&gt;&lt;td&gt;402 CARD_DECLINED&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;PENDING → PENDING&lt;/td&gt;&lt;td&gt;эмулятор: h = 9&lt;/td&gt;&lt;td&gt;system&lt;/td&gt;&lt;td&gt;— (статус не меняется)&lt;/td&gt;&lt;td&gt;202 GATEWAY_TIMEOUT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;PENDING → DECLINED&lt;/td&gt;&lt;td&gt;сверка: 15 мин без ответа&lt;/td&gt;&lt;td&gt;system&lt;/td&gt;&lt;td&gt;payment_declined&lt;/td&gt;&lt;td&gt;— (фоновый процесс)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CREATED → CANCELED&lt;/td&gt;&lt;td&gt;cancel или истёк exp / 15 мин&lt;/td&gt;&lt;td&gt;client / system&lt;/td&gt;&lt;td&gt;payment_canceled&lt;/td&gt;&lt;td&gt;200&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;PENDING → CANCELED&lt;/td&gt;&lt;td&gt;cancel&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;409 CANCEL_NOT_ALLOWED&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;SUCCESS → CANCELED&lt;/td&gt;&lt;td&gt;cancel&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;409 CANCEL_NOT_ALLOWED&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1240" height="300" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Жизненный цикл платежа&lt;/b&gt;" style="text;html=1;fontSize=24;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="600" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>