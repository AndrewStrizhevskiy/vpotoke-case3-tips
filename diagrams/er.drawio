<mxfile host="app.diagrams.net"><diagram id="er" name="ER-модель"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1560" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="merchant" value="&lt;div style=&quot;font-weight:bold;color:#3d8b4f;padding:4px&quot;&gt;Merchant&lt;/div&gt;&lt;table style=&quot;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;merchant_id&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;m_NNN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;name&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;1–100&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;status&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;ACTIVE / BLOCKED / PENDING&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;description&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;0–200, необяз.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d8b4f;strokeWidth=2;verticalAlign=top;align=left;overflow=fill;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="300" height="136" as="geometry"/></mxCell><mxCell id="receipt" value="&lt;div style=&quot;font-weight:bold;color:#868e96;padding:4px&quot;&gt;Receipt (реестр POS)&lt;/div&gt;&lt;table style=&quot;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;receipt_id&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;r_NNNN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;PK FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;merchant_id&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;→ Merchant&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;amount&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;decimal, 0 &amp;lt; x ≤ 1 000 000&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;currency&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;RUB&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#868e96;strokeWidth=2;verticalAlign=top;align=left;overflow=fill;dashed=1;" vertex="1" parent="1"><mxGeometry x="440" y="120" width="300" height="136" as="geometry"/></mxCell><mxCell id="report" value="&lt;div style=&quot;font-weight:bold;color:#7048a8;padding:4px&quot;&gt;Report&lt;/div&gt;&lt;table style=&quot;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;report_id&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;rep_NNNN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;merchant_id&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;→ Merchant&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;period&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;YYYY-MM&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;tips_total&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;≥ 0, по SUCCESS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;payments_count&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;≥ 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;avg_tip_pct&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;0–50&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;success_rate&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;0–1&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7048a8;strokeWidth=2;verticalAlign=top;align=left;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1200" y="120" width="300" height="202" as="geometry"/></mxCell><mxCell id="employee" value="&lt;div style=&quot;font-weight:bold;color:#3d8b4f;padding:4px&quot;&gt;Employee&lt;/div&gt;&lt;table style=&quot;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;employee_id&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;e_NNN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;merchant_id&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;→ Merchant&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;name&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;1–100&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;payment_details&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;только ****NNNN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d8b4f;strokeWidth=2;verticalAlign=top;align=left;overflow=fill;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="300" height="136" as="geometry"/></mxCell><mxCell id="qr" value="&lt;div style=&quot;font-weight:bold;color:#3b6fb6;padding:4px&quot;&gt;QR&lt;/div&gt;&lt;table style=&quot;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;qr_id&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;qr_NNN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;merchant_id&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;→ Merchant&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;employee_id&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;→ Employee&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;receipt_id&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;→ Receipt&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;UK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;nonce&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;6 hex, одноразовый&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;exp&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;ISO 8601, ≤ +24 ч&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;signature&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;HMAC-SHA256, 16 hex&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b6fb6;strokeWidth=2;verticalAlign=top;align=left;overflow=fill;" vertex="1" parent="1"><mxGeometry x="440" y="420" width="300" height="202" as="geometry"/></mxCell><mxCell id="payment" value="&lt;div style=&quot;font-weight:bold;color:#d9822b;padding:4px&quot;&gt;Payment&lt;/div&gt;&lt;table style=&quot;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;payment_id&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;p_NNNN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;qr_id&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;→ QR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;merchant_id&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;денорм., отчёты&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;employee_id&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;денорм., отчёты&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;amount&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;0 &amp;lt; x ≤ 1 000 000&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;tip&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;0 ≤ x ≤ amount × 0.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;amount_total&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;amount + tip&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;status&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;5 статусов&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;UK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;idempotency_key&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;UUID, уник. в qr_id&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;error_code&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;необяз.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;timestamp&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;ISO 8601, UTC&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9822b;strokeWidth=2;verticalAlign=top;align=left;overflow=fill;" vertex="1" parent="1"><mxGeometry x="820" y="420" width="300" height="290" as="geometry"/></mxCell><mxCell id="audit" value="&lt;div style=&quot;font-weight:bold;color:#c0392b;padding:4px&quot;&gt;AuditEvent&lt;/div&gt;&lt;table style=&quot;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;event_id&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;evt_NNNN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;payment_id&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;→ Payment&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;qr_id&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;денорм.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;action&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;payment_created…&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;from_status&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;статус или null&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;to_status&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;статус&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;amount_total&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;decimal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;actor&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;client / system / officer&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;at&lt;/td&gt;&lt;td style=&quot;color:#6c757d&quot;&gt;ISO 8601, UTC&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;verticalAlign=top;align=left;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1200" y="420" width="300" height="246" as="geometry"/></mxCell><mxCell id="r0" value="1 : N — работают" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="merchant" target="employee"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r1" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.368;exitDx=0;exitDy=0;entryX=0.000;entryY=0.368;entryDx=0;entryDy=0;" edge="1" parent="1" source="merchant" target="receipt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r2" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.809;exitDx=0;exitDy=0;entryX=0.000;entryY=0.297;entryDx=0;entryDy=0;" edge="1" parent="1" source="merchant" target="qr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="230"/><mxPoint x="400" y="480"/></Array></mxGeometry></mxCell><mxCell id="r3" value="1 : N — перевыпуск после exp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="receipt" target="qr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r4" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.000;exitY=1.029;exitDx=0;exitDy=0;entryX=0.000;entryY=0.693;entryDx=0;entryDy=0;" edge="1" parent="1" source="employee" target="qr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r5" value="1 : N — попытки" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.495;exitDx=0;exitDy=0;entryX=0.000;entryY=0.345;entryDx=0;entryDy=0;" edge="1" parent="1" source="qr" target="payment"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r6" value="1 : N — переходы" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.345;exitDx=0;exitDy=0;entryX=0.000;entryY=0.407;entryDx=0;entryDy=0;" edge="1" parent="1" source="payment" target="audit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r7" value="1 : N — отчёт за период" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.167;exitY=0.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="merchant" target="report"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="100"/><mxPoint x="1350" y="100"/></Array></mxGeometry></mxCell><mxCell id="note" value="Связи 1:N. Подписи у концов линий: 1 — сторона «один», N — сторона «много».&lt;br&gt;Payment.merchant_id / employee_id и AuditEvent.qr_id — денормализация ради отчётов, отдельными линиями не показаны.&lt;br&gt;Инвариант: QR.merchant_id = Employee.merchant_id = Receipt.merchant_id. Receipt — внешний реестр кассы (пунктир, ADR-003)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#ced4da;align=left;spacingLeft=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1480" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>